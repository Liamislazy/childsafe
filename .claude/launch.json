{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-demo",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["scripts/web_demo.py"],
      "port": 8000
    },
    {
      "name": "web-demo-accurate",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["scripts/web_demo.py", "--accurate"],
      "port": 8000
    },
    {
      "name": "play-area",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-X", "utf8", "scripts/play_area_demo.py", "--port", "8002"],
      "port": 8002
    }
  ]
}
